DATABASE_URL=postgresql://campovivo:campo_vivo_local@localhost:5432/campovivo
# Separate ADMIN finance database. Use a dedicated database role/password.
ADMIN_DATABASE_URL=postgresql://campovivo_admin:replace-with-a-random-password@localhost:5432/campovivo_admin
# Optional provisioning connection with CREATEROLE and CREATEDB privileges.
ADMIN_DATABASE_BOOTSTRAP_URL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Used only by npm run db:seed; remove after the first administrator is created.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
INITIAL_ADMIN_ROLE=ADMIN
INITIAL_TENANT_NAME=Meu Centro Equestre
INITIAL_PLAN=CTE
